{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRADER X Paper Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "strategy_version",
    "config_hash",
    "mode",
    "data_kind",
    "data_window",
    "data_quality",
    "evidence_status",
    "closed_trades",
    "limitations"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "const": "PAPER"},
    "data_kind": {"type": "string", "enum": ["historical", "replay", "synthetic"]},
    "data_window": {"type": "object", "required": ["start", "end", "symbol", "timeframe"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "symbol": {"type": "string"}, "timeframe": {"type": "string"}}},
    "data_quality": {"type": "object", "required": ["issues_count"], "properties": {"issues_count": {"type": "integer", "minimum": 0}}},
    "evidence_status": {"type": "string", "enum": ["VERIFIED", "INSUFFICIENT_EVIDENCE"]},
    "closed_trades": {"type": "integer", "minimum": 0},
    "metrics": {"type": "object"},
    "rejection_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
